diff --git a/src/drivers/mou_evdev.c b/src/drivers/mou_evdev.c
new file mode 100644
index 0000000..67c1b5a
--- /dev/null
+++ b/src/drivers/mou_evdev.c
@@ -0,0 +1,77 @@
+/*
+ * Linux evdev mouse driver for Nano-X (added by ConMon Lab).
+ * Prefers an absolute pointer (VMware vmmouse, tablets) so the cursor sits
+ * exactly under the host's mouse or finger; falls back to a relative mouse.
+ */
+#include <stdio.h>
+#include <errno.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <linux/input.h>
+#include "device.h"
+
+static int fd = -1, absolute, ax, ay, rx, ry, buttons, minx, maxx = 65535, miny, maxy = 65535;
+
+#define TEST_BIT(bits, n) ((bits)[(n) / (8 * sizeof(long))] & (1UL << ((n) % (8 * sizeof(long)))))
+
+static int Ev_Open(MOUSEDEVICE *pmd) {
+	char path[32];
+	int rel_fd = -1;
+	for (int i = 0; i < 16; i++) {
+		unsigned long ev[1] = { 0 }, abs[1] = { 0 };
+		snprintf(path, sizeof path, "/dev/input/event%d", i);
+		int f = open(path, O_RDONLY | O_NONBLOCK);
+		if (f < 0) continue;
+		ioctl(f, EVIOCGBIT(0, sizeof ev), ev);
+		if (TEST_BIT(ev, EV_ABS)) {
+			ioctl(f, EVIOCGBIT(EV_ABS, sizeof abs), abs);
+			if (TEST_BIT(abs, ABS_X) && TEST_BIT(abs, ABS_Y)) {
+				struct input_absinfo ix, iy;
+				if (!ioctl(f, EVIOCGABS(ABS_X), &ix)) { minx = ix.minimum; maxx = ix.maximum; }
+				if (!ioctl(f, EVIOCGABS(ABS_Y), &iy)) { miny = iy.minimum; maxy = iy.maximum; }
+				if (rel_fd >= 0) close(rel_fd);
+				fd = f; absolute = 1;
+				return fd;
+			}
+		}
+		if (TEST_BIT(ev, EV_REL) && rel_fd < 0) { rel_fd = f; continue; }
+		close(f);
+	}
+	if (rel_fd < 0) return MOUSE_FAIL;
+	fd = rel_fd; absolute = 0;
+	return fd;
+}
+
+static void Ev_Close(void) { if (fd >= 0) close(fd); fd = -1; }
+static int Ev_GetButtonInfo(void) { return MWBUTTON_L | MWBUTTON_M | MWBUTTON_R | MWBUTTON_SCROLLUP | MWBUTTON_SCROLLDN; }
+static void Ev_GetDefaultAccel(int *pscale, int *pthresh) { *pscale = absolute ? 1 : 2; *pthresh = absolute ? 1000 : 5; }
+
+static int Ev_Read(MWCOORD *px, MWCOORD *py, MWCOORD *pz, int *pb) {
+	struct input_event e;
+	int wheel = 0;
+	while (read(fd, &e, sizeof e) == sizeof e) {
+		if (e.type == EV_ABS && e.code == ABS_X) ax = e.value;
+		else if (e.type == EV_ABS && e.code == ABS_Y) ay = e.value;
+		else if (e.type == EV_REL && e.code == REL_X) rx += e.value;
+		else if (e.type == EV_REL && e.code == REL_Y) ry += e.value;
+		else if (e.type == EV_REL && e.code == REL_WHEEL) wheel = e.value;
+		else if (e.type == EV_KEY) {
+			int b = e.code == BTN_LEFT ? MWBUTTON_L : e.code == BTN_RIGHT ? MWBUTTON_R : e.code == BTN_MIDDLE ? MWBUTTON_M : 0;
+			if (e.value) buttons |= b; else buttons &= ~b;
+		} else if (e.type == EV_SYN && e.code == SYN_REPORT) {
+			*pz = 0;
+			*pb = buttons | (wheel > 0 ? MWBUTTON_SCROLLUP : wheel < 0 ? MWBUTTON_SCROLLDN : 0);
+			if (absolute) {
+				*px = (MWCOORD)((long long)(ax - minx) * (scrdev.xres - 1) / (maxx - minx ? maxx - minx : 1));
+				*py = (MWCOORD)((long long)(ay - miny) * (scrdev.yres - 1) / (maxy - miny ? maxy - miny : 1));
+				return MOUSE_ABSPOS;
+			}
+			*px = rx; *py = ry; rx = ry = 0;
+			return MOUSE_RELPOS;
+		}
+	}
+	return MOUSE_NODATA;
+}
+
+MOUSEDEVICE mousedev = { Ev_Open, Ev_Close, Ev_GetButtonInfo, Ev_GetDefaultAccel, Ev_Read, NULL, MOUSE_NORMAL };
